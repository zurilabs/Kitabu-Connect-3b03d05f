# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MySQL)
# Option 1: Use DATABASE_URL (Railway, production)
# DATABASE_URL=mysql://user:password@host:port/database

# Option 2: Use individual credentials (local development)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=kitabu_connect

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# SMS/OTP Configuration (for production)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Cloudinary Configuration (Image Storage)
# Sign up at https://cloudinary.com (Free tier: 25GB storage, 25GB bandwidth)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Paystack Configuration (Payment Gateway)
# Sign up at https://paystack.com
# Get your keys from: Dashboard > Settings > API Keys & Webhooks
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here

# Frontend URL (for payment callbacks and webhooks)
# For development with ngrok:
#   1. Run: ngrok http 5000
#   2. Copy the HTTPS URL (e.g., https://abc123.ngrok.io)
#   3. Set it here: FRONTEND_URL=https://abc123.ngrok.io
# For production: Set to your domain (e.g., https://yourdomain.com)
FRONTEND_URL=http://localhost:5000


VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=

# Google Analytics 4 Configuration
# Sign up at https://analytics.google.com
# Create a GA4 property and copy the Measurement ID (format: G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# School-cluster pilot (ADR adr-016, branch pilot/school-cluster-2027)
# ---------------------------------------------------------------------------
# PILOT_MODE (server): defaults to true when unset. In pilot mode the platform never
# holds money: purchase orders + Paystack initialisation, escrow, wallet top-ups and
# withdrawals, and all platform fees are off (routes return 410), and the escrow-release,
# cycle-timeout and cycle-detection schedulers do not start. Set to false to restore them.
PILOT_MODE=true
# VITE_PILOT_MODE (client): same meaning for the UI. Defaults to true when unset.
# It is read at build time, so rebuild the client after changing it.
VITE_PILOT_MODE=true
